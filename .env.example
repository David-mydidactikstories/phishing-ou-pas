# Moteur vocal principal : ElevenLabs Agents (à définir dans Render > Environment, jamais dans le code)
ELEVENLABS_API_KEY=
# Optionnel : remplacer un agent (par défaut ceux du projet)
# EL_AGENT_1=agent_...   # Thomas (banque)
# EL_AGENT_2=agent_...   # Julien (IT)
# EL_AGENT_3=agent_...   # Marc Delvaux
# EL_AGENT_4=agent_...   # Stéphanie (colis)

# Moteur de secours : Gemini Live (utilisé si ELEVENLABS_API_KEY est absente, ou avec ?engine=gemini)
GEMINI_API_KEY=
# LIVE_MODEL=gemini-3.8-live
